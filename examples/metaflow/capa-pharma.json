{
  "version": 1,
  "tenant": {
    "id": "00000000-0000-0000-0000-000000000001",
    "name": "Pharma Compliance Tenant",
    "slug": "pharma-compliance"
  },
  "app": {
    "name": "CAPA Management System",
    "description": "Corrective and Preventive Action process for pharmaceutical quality assurance and compliance."
  },
  "objectTypes": [
    {
      "symbolicId": "$capa",
      "displayName": "CAPA",
      "processFlag": "Quality",
      "config": {
        "titleKey": "title",
        "primaryKey": "id",
        "properties": {
          "title": {
            "type": "string",
            "required": true,
            "displayName": "Title"
          },
          "description": {
            "type": "string",
            "required": true,
            "displayName": "Description"
          },
          "status": {
            "type": "string",
            "required": true,
            "displayName": "Status",
            "picklistConfig": {
              "options": [
                "Draft",
                "Investigation",
                "Plan Development",
                "Implementation",
                "Effectiveness Check",
                "Closed"
              ],
              "defaultValue": "Draft",
              "allowMultiple": false
            }
          },
          "severity": {
            "type": "string",
            "required": true,
            "displayName": "Severity",
            "picklistConfig": {
              "options": [
                "Critical",
                "Major",
                "Minor"
              ],
              "defaultValue": "Major",
              "allowMultiple": false
            }
          },
          "priority": {
            "type": "string",
            "required": false,
            "displayName": "Priority",
            "picklistConfig": {
              "options": [
                "Low",
                "Medium",
                "High"
              ],
              "defaultValue": "Medium",
              "allowMultiple": false
            }
          },
          "source": {
            "type": "string",
            "required": true,
            "displayName": "Source",
            "picklistConfig": {
              "options": [
                "Internal Audit",
                "External Audit",
                "Customer Complaint",
                "Deviation",
                "Management Review"
              ],
              "allowMultiple": false
            }
          },
          "rootCause": {
            "type": "string",
            "required": false,
            "displayName": "Root Cause"
          },
          "initialAssessment": {
            "type": "string",
            "required": false,
            "displayName": "Initial Assessment"
          },
          "investigationSummary": {
            "type": "string",
            "required": false,
            "displayName": "Investigation Summary"
          },
          "planApprovalNotes": {
            "type": "string",
            "required": false,
            "displayName": "Plan Approval Notes"
          },
          "implementationSummary": {
            "type": "string",
            "required": false,
            "displayName": "Implementation Summary"
          },
          "verificationNotes": {
            "type": "string",
            "required": false,
            "displayName": "Verification Notes"
          },
          "lastActivityAt": {
            "type": "timestamp",
            "required": false,
            "displayName": "Last Activity At"
          }
        }
      }
    },
    {
      "symbolicId": "$action_item",
      "displayName": "Action Item",
      "processFlag": "Quality",
      "config": {
        "titleKey": "task",
        "primaryKey": "id",
        "properties": {
          "task": {
            "type": "string",
            "required": true,
            "displayName": "Task"
          },
          "assignedTo": {
            "type": "string",
            "required": true,
            "displayName": "Assigned To"
          },
          "dueDate": {
            "type": "timestamp",
            "required": true,
            "displayName": "Due Date"
          },
          "isCompleted": {
            "type": "boolean",
            "required": true,
            "displayName": "Completed"
          },
          "capaId": {
            "type": "object-reference",
            "required": true,
            "displayName": "CAPA",
            "referenceConfig": {
              "targetObjectTypeId": "$capa"
            }
          }
        }
      }
    }
  ],
  "relationships": [
    {
      "symbolicId": "$capa_has_action_items",
      "displayName": "CAPA has Action Items",
      "processFlag": "Quality",
      "cardinality": "ONE_TO_MANY",
      "sourceObjectTypeId": "$capa",
      "targetObjectTypeId": "$action_item",
      "sourceDisplayName": "CAPA",
      "targetDisplayName": "Action Items",
      "propertyName": "capaId",
      "config": {
        "notes": "Tasks associated with the CAPA implementation"
      }
    }
  ],
  "actions": [
