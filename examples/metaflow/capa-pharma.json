      "symbolicId": "$start_investigation",
      "displayName": "Start Investigation",
      "processFlag": "Quality",
      "config": {
        "rules": [
          {
            "type": "modify_object",
            "properties": {
              "status": {
                "value": "Investigation",
                "source": "static"
              },
              "initialAssessment": {
                "source": "parameter",
                "parameterName": "assessment"
              },
              "priority": {
                "source": "parameter",
                "parameterName": "priority"
              },
              "lastActivityAt": {
                "source": "current_timestamp"
              }
            },
            "objectParameter": "capa"
          }
        ],
        "parameters": [
          {
            "name": "capa",
            "type": "object-reference",
            "required": true,
            "displayName": "CAPA",
            "objectTypeId": "$capa"
          },
          {
            "name": "assessment",
            "type": "string",
            "required": true,
            "displayName": "Initial Assessment"
          },
          {
            "name": "priority",
            "type": "string",
            "required": true,
            "displayName": "Priority",
            "picklistConfig": {
              "options": [
                "Low",
                "Medium",
                "High"
              ],
              "allowMultiple": false
            }
          }
        ],
        "description": "Moves CAPA to Investigation stage with initial assessment and priority",
        "executionType": "declarative",
        "submissionCriteria": [
          {
            "left": {
              "path": {
                "segments": [],
                "baseParameterName": "capa",
                "terminalPropertyKey": "status"
              },
              "type": "property"
            },
            "type": "comparison",
            "right": {
              "type": "static",
              "value": "Draft"
            },
            "operator": "="
          }
        ]
      }
    },
    {
      "symbolicId": "$complete_investigation",
      "displayName": "Complete Investigation",
      "processFlag": "Quality",
      "config": {
        "rules": [
          {
            "type": "modify_object",
            "properties": {
              "status": {
                "value": "Plan Development",
                "source": "static"
