{
  "version": 1,
  "tenant": {
    "id": "00000000-0000-0000-0000-000000000001",
    "name": "Current Tenant",
    "slug": "current"
  },
  "app": {
    "name": "Evidence-Based Project Funding",
    "description": "A workflow for project funding requiring evidence submission at every transition stage."
  },
  "objectTypes": [
    {
      "symbolicId": "$object:project",
      "displayName": "Funding Project",
      "processFlag": "ProjectFunding",
      "config": {
        "titleKey": "title",
        "primaryKey": "id",
        "properties": {
          "title": {
            "type": "string",
            "required": true,
            "displayName": "Project Title"
          },
          "description": {
            "type": "string",
            "required": true,
            "displayName": "Project Description"
          },
          "status": {
            "type": "string",
            "required": true,
            "displayName": "Status",
            "picklistConfig": {
              "options": [
                "Draft",
                "Technical Evaluation",
                "Financial Audit",
                "Board Approval",
                "Funded",
                "Rejected"
              ],
              "defaultValue": "Draft",
              "allowMultiple": false
            }
          },
          "technicalEvidence": {
            "type": "string",
            "required": false,
            "displayName": "Technical Evaluation Evidence"
          },
          "financialEvidence": {
            "type": "string",
            "required": false,
            "displayName": "Financial Audit Evidence"
          },
          "boardMeetingNotes": {
            "type": "string",
            "required": false,
            "displayName": "Board Meeting Notes"
          },
          "lastUpdated": {
            "type": "timestamp",
            "required": false,
            "displayName": "Last Updated"
          }
        }
      }
    }
  ],
  "relationships": [],
  "actions": [
    {
      "symbolicId": "$action:submit_for_technical",
      "displayName": "Submit for Technical Evaluation",
      "processFlag": "ProjectFunding",
      "config": {
        "rules": [
          {
            "type": "modify_object",
            "properties": {
              "status": {
                "value": "Technical Evaluation",
                "source": "static"
              },
              "lastUpdated": {
                "source": "current_timestamp"
              }
            },
            "objectParameter": "project"
          }
        ],
        "parameters": [
          {
            "name": "project",
            "type": "object-reference",
            "required": true,
            "displayName": "Project",
            "objectTypeId": "$object:project"
          }
        ],
        "description": "Moves the project from Draft to Technical Evaluation.",
        "executionType": "declarative",
        "submissionCriteria": [
          {
            "left": {
              "path": {
                "segments": [],
                "baseParameterName": "project",
                "terminalPropertyKey": "status"
              },
              "type": "property"
            },
            "type": "comparison",
            "right": {
              "type": "static",
              "value": "Draft"
            },
            "operator": "="
          }
        ]
      }
    },
    {
      "symbolicId": "$action:complete_technical_evaluation",
      "displayName": "Complete Technical Evaluation",
      "processFlag": "ProjectFunding",
      "config": {
        "rules": [
          {
            "type": "modify_object",
            "properties": {
              "status": {
                "value": "Financial Audit",
                "source": "static"
              },
              "technicalEvidence": {
                "source": "parameter",
                "parameterName": "evidence"
              },
              "lastUpdated": {
                "source": "current_timestamp"
              }
            },
            "objectParameter": "project"
          }
        ],
        "parameters": [
          {
            "name": "project",
            "type": "object-reference",
            "required": true,
            "displayName": "Project",
            "objectTypeId": "$object:project"
          },
          {
            "name": "evidence",
            "type": "string",
            "required": true,
            "displayName": "Technical Evidence / Report Summary"
          }
        ],
        "description": "Records technical evidence and moves to Financial Audit.",
        "executionType": "declarative",
        "submissionCriteria": [
          {
            "left": {
              "path": {
                "segments": [],
                "baseParameterName": "project",
                "terminalPropertyKey": "status"
              },
              "type": "property"
            },
            "type": "comparison",
            "right": {
              "type": "static",
              "value": "Technical Evaluation"
            },
            "operator": "="
          }
        ]
      }
    },
    {
      "symbolicId": "$action:complete_financial_audit",
      "displayName": "Complete Financial Audit",
      "processFlag": "ProjectFunding",
      "config": {
        "rules": [
          {
            "type": "modify_object",
            "properties": {
              "status": {
                "value": "Board Approval",
                "source": "static"
              },
              "financialEvidence": {
                "source": "parameter",
                "parameterName": "evidence"
              },
              "lastUpdated": {
                "source": "current_timestamp"
              }
            },
            "objectParameter": "project"
          }
        ],
        "parameters": [
          {
            "name": "project",
            "type": "object-reference",
            "required": true,
            "displayName": "Project",
            "objectTypeId": "$object:project"
          },
          {
            "name": "evidence",
            "type": "string",
            "required": true,
            "displayName": "Financial Audit Evidence / Summary"
          }
        ],
        "description": "Records financial evidence and moves to Board Approval.",
        "executionType": "declarative",
        "submissionCriteria": [
          {
            "left": {
              "path": {
                "segments": [],
                "baseParameterName": "project",
                "terminalPropertyKey": "status"
              },
              "type": "property"
            },
            "type": "comparison",
            "right": {
              "type": "static",
              "value": "Financial Audit"
            },
            "operator": "="
          }
        ]
      }
    },
    {
      "symbolicId": "$action:final_board_decision",
      "displayName": "Final Board Decision",
      "processFlag": "ProjectFunding",
      "config": {
        "rules": [
          {
            "type": "modify_object",
            "properties": {
              "status": {
                "source": "parameter",
                "parameterName": "decision"
              },
              "boardMeetingNotes": {
                "source": "parameter",
                "parameterName": "notes"
              },
              "lastUpdated": {
                "source": "current_timestamp"
              }
            },
            "objectParameter": "project"
          }
        ],
        "parameters": [
          {
            "name": "project",
            "type": "object-reference",
            "required": true,
            "displayName": "Project",
            "objectTypeId": "$object:project"
          },
          {
            "name": "decision",
            "type": "string",
            "required": true,
            "displayName": "Decision",
            "picklistConfig": {
              "options": [
                "Funded",
                "Rejected"
              ],
              "allowMultiple": false
            }
          },
          {
            "name": "notes",
            "type": "string",
            "required": true,
            "displayName": "Board Meeting Notes"
          }
        ],
        "description": "Records board decision and notes, finalizing the process.",
        "executionType": "declarative",
        "submissionCriteria": [
          {
            "left": {
              "path": {
                "segments": [],
                "baseParameterName": "project",
                "terminalPropertyKey": "status"
              },
              "type": "property"
            },
            "type": "comparison",
            "right": {
              "type": "static",
              "value": "Board Approval"
            },
            "operator": "="
          }
        ]
      }
    }
  ],
  "processLayouts": [
    {
      "symbolicId": "$process:funding_flow",
      "processName": "Project Funding Lifecycle",
      "processFlag": "ProjectFunding",
      "objectTypeIds": [
        "$object:project"
      ],
      "trackedPicklists": [
        "status"
      ],
      "layoutData": {
        "edges": [],
        "nodes": [],
        "version": 1
      }
    }
  ]
}