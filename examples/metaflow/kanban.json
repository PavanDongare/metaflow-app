{
  "version": 1,
  "tenant": {
    "id": "00000000-0000-0000-0000-000000000001",
    "name": "Current Tenant",
    "slug": "current"
  },
  "app": {
    "name": "Kanban Task Management",
    "description": "A workflow for managing tasks through a kanban board with required evidence and documentation at each step."
  },
  "objectTypes": [
    {
      "symbolicId": "$object:task",
      "displayName": "Task",
      "processFlag": "KanbanProcess",
      "config": {
        "titleKey": "title",
        "primaryKey": "id",
        "properties": {
          "title": {
            "type": "string",
            "required": true,
            "displayName": "Task Title"
          },
          "description": {
            "type": "string",
            "required": true,
            "displayName": "Description"
          },
          "status": {
            "type": "string",
            "required": true,
            "displayName": "Status",
            "picklistConfig": {
              "options": [
                "To Do",
                "In Progress",
                "In Review",
                "Done"
              ],
              "defaultValue": "To Do",
              "allowMultiple": false
            }
          },
          "priority": {
            "type": "string",
            "required": true,
            "displayName": "Priority",
            "picklistConfig": {
              "options": [
                "Low",
                "Medium",
                "High"
              ],
              "defaultValue": "Medium",
              "allowMultiple": false
            }
          },
          "estimatedHours": {
            "type": "number",
            "required": false,
            "displayName": "Estimated Hours"
          },
          "reviewLink": {
            "type": "string",
            "required": false,
            "displayName": "Review Link"
          },
          "comments": {
            "type": "string",
            "required": false,
            "displayName": "Comments"
          },
          "completionNotes": {
            "type": "string",
            "required": false,
            "displayName": "Completion Notes"
          },
          "reopenReason": {
            "type": "string",
            "required": false,
            "displayName": "Reopen Reason"
          },
          "lastUpdated": {
            "type": "timestamp",
            "required": false,
            "displayName": "Last Updated"
          }
        }
      }
    }
  ],
  "relationships": [],
  "actions": [
    {
      "symbolicId": "$action:start_work",
      "displayName": "Start Work",
      "processFlag": "KanbanProcess",
      "config": {
        "rules": [
          {
            "type": "modify_object",
            "properties": {
              "status": {
                "value": "In Progress",
                "source": "static"
              },
              "estimatedHours": {
                "source": "parameter",
                "parameterName": "hours"
              },
              "lastUpdated": {
                "source": "current_timestamp"
              }
            },
            "objectParameter": "task"
          }
        ],
        "parameters": [
          {
            "name": "task",
            "type": "object-reference",
            "required": true,
            "displayName": "Task",
            "objectTypeId": "$object:task"
          },
          {
            "name": "hours",
            "type": "number",
            "required": true,
            "displayName": "Estimated Hours to Complete"
          }
        ],
        "description": "Moves task to In Progress and records estimated hours.",
        "executionType": "declarative",
        "submissionCriteria": [
          {
            "left": {
              "path": {
                "segments": [],
                "baseParameterName": "task",
                "terminalPropertyKey": "status"
              },
              "type": "property"
            },
            "type": "comparison",
            "right": {
              "type": "static",
              "value": "To Do"
            },
            "operator": "="
          }
        ]
      }
    },
    {
      "symbolicId": "$action:submit_for_review",
      "displayName": "Submit for Review",
      "processFlag": "KanbanProcess",
      "config": {
        "rules": [
          {
            "type": "modify_object",
            "properties": {
              "status": {
                "value": "In Review",
                "source": "static"
              },
              "reviewLink": {
                "source": "parameter",
                "parameterName": "link"
              },
              "comments": {
                "source": "parameter",
                "parameterName": "dev_comments"
              },
              "lastUpdated": {
                "source": "current_timestamp"
              }
            },
            "objectParameter": "task"
          }
        ],
        "parameters": [
          {
            "name": "task",
            "type": "object-reference",
            "required": true,
            "displayName": "Task",
            "objectTypeId": "$object:task"
          },
          {
            "name": "link",
            "type": "string",
            "required": true,
            "displayName": "Review URL / Pull Request"
          },
          {
            "name": "dev_comments",
            "type": "string",
            "required": false,
            "displayName": "Developer Comments"
          }
        ],
        "description": "Moves task to In Review and provides necessary links.",
        "executionType": "declarative",
        "submissionCriteria": [
          {
            "left": {
              "path": {
                "segments": [],
                "baseParameterName": "task",
                "terminalPropertyKey": "status"
              },
              "type": "property"
            },
            "type": "comparison",
            "right": {
              "type": "static",
              "value": "In Progress"
            },
            "operator": "="
          }
        ]
      }
    },
    {
      "symbolicId": "$action:approve_and_complete",
      "displayName": "Approve and Complete",
      "processFlag": "KanbanProcess",
      "config": {
        "rules": [
          {
            "type": "modify_object",
            "properties": {
              "status": {
                "value": "Done",
                "source": "static"
              },
              "completionNotes": {
                "source": "parameter",
                "parameterName": "notes"
              },
              "lastUpdated": {
                "source": "current_timestamp"
              }
            },
            "objectParameter": "task"
          }
        ],
        "parameters": [
          {
            "name": "task",
            "type": "object-reference",
            "required": true,
            "displayName": "Task",
            "objectTypeId": "$object:task"
          },
          {
            "name": "notes",
            "type": "string",
            "required": true,
            "displayName": "Closure / Completion Notes"
          }
        ],
        "description": "Finalizes the task after successful review.",
        "executionType": "declarative",
        "submissionCriteria": [
          {
            "left": {
              "path": {
                "segments": [],
                "baseParameterName": "task",
                "terminalPropertyKey": "status"
              },
              "type": "property"
            },
            "type": "comparison",
            "right": {
              "type": "static",
              "value": "In Review"
            },
            "operator": "="
          }
        ]
      }
    },
    {
      "symbolicId": "$action:update_task_details",
      "displayName": "Update Task Details",
      "processFlag": "KanbanProcess",
      "config": {
        "rules": [
          {
            "type": "modify_object",
            "properties": {
              "priority": {
                "source": "parameter",
                "parameterName": "new_priority"
              },
              "description": {
                "source": "parameter",
                "parameterName": "new_description"
              },
              "lastUpdated": {
                "source": "current_timestamp"
              }
            },
            "objectParameter": "task"
          }
        ],
        "parameters": [
          {
            "name": "task",
            "type": "object-reference",
            "required": true,
            "displayName": "Task",
            "objectTypeId": "$object:task"
          },
          {
            "name": "new_priority",
            "type": "string",
            "required": true,
            "displayName": "New Priority",
            "picklistConfig": {
              "options": [
                "Low",
                "Medium",
                "High"
              ],
              "allowMultiple": false
            }
          },
          {
            "name": "new_description",
            "type": "string",
            "required": true,
            "displayName": "Updated Description"
          }
        ],
        "description": "Updates priority and description without changing state.",
        "executionType": "declarative",
        "submissionCriteria": []
      }
    }
  ],
  "processLayouts": [
    {
      "symbolicId": "$process:kanban_flow",
      "processName": "Standard Kanban Workflow",
      "processFlag": "KanbanProcess",
      "objectTypeIds": [
        "$object:task"
      ],
      "trackedPicklists": [
        "status"
      ],
      "layoutData": {
        "edges": [],
        "nodes": [],
        "version": 1
      }
    }
  ]
}
